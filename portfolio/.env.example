# ------------------------------------------------------------------
# Portfolio site — environment variables
# Copy this file to .env.local for local development (never commit
# .env.local — it's gitignored).
# ------------------------------------------------------------------

# --- Simple password auth (required for /admin) ---
# The plaintext password checked at login (app/api/admin/login/route.ts).
ADMIN_PASSWORD=change-me

# Secret used to HMAC-sign the admin session cookie (lib/session.ts).
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Google OAuth (NextAuth v5 / Auth.js) — optional, restricted admin login ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (and http://localhost:3000/api/auth/callback/google for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this email is allowed to sign in via Google (auth.ts signIn callback).
ADMIN_EMAIL=rashiwork17@gmail.com

# NextAuth session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Base URL of the deployed app. Auto-detected on Vercel; set explicitly for
# local dev, e.g. http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- Vercel KV (Upstash Redis) — persistent storage for content + messages ---
# Add the "Vercel KV" (or Upstash) integration from the Vercel dashboard's
# Storage tab; these two vars are injected automatically once connected.
# If left unset, the app falls back to reading/writing data/content.json and
# data/messages.json locally, so `npm run dev` works without any KV setup.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Resend (transactional email for the contact form) ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Recipient of contact form notifications (defaults to rashiwork17@gmail.com).
CONTACT_TO_EMAIL=rashiwork17@gmail.com

# Sender address. Must be on a domain verified in Resend, or use the Resend
# sandbox sender "onboarding@resend.dev" for testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev
